# AgentFlow environment template.
# Copy to .env (never commit .env) and replace every change-me value.
# Variables are added here by the step that first reads them.

# --- Local infrastructure (Docker Compose) and backend connection settings ---
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentflow
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# --- Backend application (optional; defaults shown) ---
# APP_ENV: development | test | production. Production disables /docs and rejects placeholder secrets.
# APP_ENV=development
# SERVICE_NAME=agentflow-api
# LOG_LEVEL=INFO
# POSTGRES_HOST=127.0.0.1
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=5
# DB_CONNECT_TIMEOUT_SECONDS=5
# REDIS_HOST=127.0.0.1
# REDIS_DB=0
# REDIS_SOCKET_TIMEOUT_SECONDS=2
# HEALTH_CHECK_TIMEOUT_SECONDS=2
# How long idempotency keys are remembered (60 s to 30 days; default 24 h).
# IDEMPOTENCY_KEY_TTL_SECONDS=86400

# --- Authentication (ADR-0007) ---
# JWT signing key ring as JSON {"<key id>": "<secret>"}; each secret at least 32 characters.
# Generate a secret with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotate by adding a new key, switching AUTH_JWT_ACTIVE_KEY_ID to it, and removing the old key
# once tokens signed with it have expired (after AUTH_ACCESS_TOKEN_TTL_SECONDS).
AUTH_JWT_SIGNING_KEYS={"k1":"change-me-generate-a-random-secret-of-at-least-32-chars"}
AUTH_JWT_ACTIVE_KEY_ID=k1
# Optional (defaults shown):
# AUTH_JWT_ISSUER=agentflow-api
# AUTH_JWT_AUDIENCE=agentflow
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900        # 60-900
# AUTH_REFRESH_TOKEN_TTL_SECONDS=604800    # refresh token lifetime; renewed on every rotation
# AUTH_SESSION_MAX_AGE_SECONDS=2592000     # absolute session lifetime; re-login required after
# AUTH_COOKIE_SECURE=                      # empty = Secure cookies in production only
# AUTH_LOGIN_ATTEMPTS_PER_MINUTE=10        # per client IP and per email
# AUTH_REQUESTS_PER_MINUTE=60              # per client IP on register/refresh/logout/invitations
# WORKSPACE_INVITATION_TTL_SECONDS=604800
# Browser origins allowed for credentialed CORS and unsafe requests (JSON list).
# CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Background execution (ADR-0010) ---
# Celery workers connect as a restricted role. Create/refresh it after migrations with:
#   cd backend; uv run python -m app.db.roles provision-worker
WORKER_DB_PASSWORD=change-me
# Optional (defaults shown):
# WORKER_DB_USER=agentflow_worker
# CELERY_BROKER_REDIS_DB=1          # Celery broker; rate limits use REDIS_DB
# OUTBOX_LEASE_SECONDS=60           # how long a relay owns a claimed outbox row
# OUTBOX_MAX_ATTEMPTS=10            # after this many failed publishes a row becomes FAILED (kept)
# OUTBOX_BATCH_SIZE=100
# CLEANUP_BATCH_SIZE=500            # rows per cleanup transaction
# CLEANUP_MAX_BATCHES=20            # batches per category per hourly run

# --- Frontend (ADR-0011) ---
# The frontend reads frontend/.env.local (gitignored), not this file. Public build-time value;
# never put secrets in NEXT_PUBLIC_* variables.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
